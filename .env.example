# --- director / LLM providers ---

# Provider selection: "gemini" (legacy default) | "openai_compatible" | "none" (offline).
DIRECTOR_LLM_PROVIDER=gemini

# Legacy path (provider=gemini): GEMINI_API_KEY powers vision + planning.
# Never commit.
GEMINI_API_KEY=

# Gemini model ids (used only when DIRECTOR_LLM_PROVIDER=gemini).
DIRECTOR_REASONING_MODEL=gemini-2.5-pro
DIRECTOR_VISION_MODEL=gemini-2.5-flash

# OpenAI-compatible path (provider=openai_compatible): works with OpenRouter,
# vLLM, or any /chat/completions endpoint. Key fallback order:
#   DIRECTOR_LLM_API_KEY -> OPENROUTER_API_KEY -> OPENAI_API_KEY
#DIRECTOR_LLM_PROVIDER=openai_compatible
#DIRECTOR_LLM_BASE_URL=https://openrouter.ai/api/v1
#DIRECTOR_LLM_API_KEY=
#OPENROUTER_API_KEY=
# Model ids are router ids, e.g.:
#   reasoning: anthropic/claude-sonnet-4.6   budget: deepseek/deepseek-v4-flash
#   vision:    google/gemini-3-flash
#DIRECTOR_REASONING_MODEL=anthropic/claude-sonnet-4.6
#DIRECTOR_VISION_MODEL=google/gemini-3-flash

# Run store location (used by `director`). Default: ./runs relative to cwd.
DIRECTOR_RUN_STORE_DIR=./runs

# --- resolve-mcp only ---

# Transport: "stdio" (default) or "http".
RESOLVE_MCP_TRANSPORT=stdio

# If "true", enable destructive tools (quit_app, restart_app, delete_timeline, delete_media).
# They ALSO require an explicit `confirm=true` argument; this flag is the global gate.
RESOLVE_MCP_ALLOW_DESTRUCTIVE=false

# --- DaVinci Resolve bootstrap (Windows / macOS) ---
# These three vars must be set OR the host must have them exported globally
# before launching the `resolve-mcp` server. See README.md "Resolve Bootstrap".
#
# Windows example (PowerShell):
#   $env:RESOLVE_SCRIPT_API  = "C:\Program Files\Blackmagic Design\DaVinci Resolve\Developer\Scripting\API"
#   $env:RESOLVE_SCRIPT_LIB  = "C:\Program Files\Blackmagic Design\DaVinci Resolve\Developer\Scripting\Lib\resolve_lite.exe"  # Studio: "...\DaVinci Resolve\..."
#   $env:PYTHONPATH          = $env:RESOLVE_SCRIPT_API
#
# Also, in DaVinci Resolve: Preferences -> General -> "External scripting using" = "Local"
# RESOLVE_SCRIPT_API=
# RESOLVE_SCRIPT_LIB=
# PYTHONPATH=
