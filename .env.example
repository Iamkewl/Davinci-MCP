# Copy to .env (gitignored) and fill in what you need. Everything here is
# optional: with no .env at all, `director ... --fast` and `resolve-mcp
# --backend fake` work offline.

# ============================ director / LLM ============================

# Provider: "gemini" (default) | "openai_compatible" | "none" (fully offline).
DIRECTOR_LLM_PROVIDER=gemini

# Gemini path: key from https://aistudio.google.com/apikey. Never commit it.
GEMINI_API_KEY=

# Model ids (provider-agnostic strings; these defaults are Gemini's).
DIRECTOR_REASONING_MODEL=gemini-2.5-pro
DIRECTOR_VISION_MODEL=gemini-2.5-flash

# OpenAI-compatible path: OpenRouter, vLLM, or anything serving
# /chat/completions. Key lookup order:
#   DIRECTOR_LLM_API_KEY -> OPENROUTER_API_KEY -> OPENAI_API_KEY
#DIRECTOR_LLM_PROVIDER=openai_compatible
#DIRECTOR_LLM_BASE_URL=https://openrouter.ai/api/v1
#DIRECTOR_LLM_API_KEY=
#OPENROUTER_API_KEY=
# Model ids are router ids for this provider, e.g.:
#DIRECTOR_REASONING_MODEL=anthropic/claude-sonnet-4.6
#DIRECTOR_VISION_MODEL=google/gemini-3-flash

# Where run history (SQLite + JSONL) is written. Default: ./runs
DIRECTOR_RUN_STORE_DIR=./runs

# Plan/review loop budget. The loop also stops early when the planner stops
# changing its answer. Default: 5
#DIRECTOR_MAX_PLANNER_ITERATIONS=5

# Review thresholds: overall score and the per-axis floor. Defaults: 0.6 / 0.4
#DIRECTOR_DIRECTOR_MIN_OVERALL=0.6
#DIRECTOR_DIRECTOR_MIN_PER_AXIS=0.4

# ============================ resolve-mcp ============================
# CLI flags beat these; anything you leave unset falls back to the default.

# Backend: "fake" (in-memory, no Resolve) or "davinci" (drives a running Resolve).
RESOLVE_MCP_BACKEND=fake

# Transport. stdio is the only one implemented.
RESOLVE_MCP_TRANSPORT=stdio

# Register the destructive tools (quit_app, restart_app, delete_timeline,
# delete_media). They ALSO require an explicit confirm=true per call.
RESOLVE_MCP_ALLOW_DESTRUCTIVE=false

# Log level. Logs go to stderr; stdout is reserved for the MCP protocol.
RESOLVE_MCP_LOG_LEVEL=INFO

# ==================== DaVinci Resolve bootstrap ====================
# Only needed if Resolve is installed somewhere non-standard: the server
# already adds the default Scripting/Modules directory for your OS to sys.path.
# In Resolve: Preferences -> General -> "External scripting using" = "Local",
# and note that external scripting requires Resolve STUDIO.
# See README.md "Resolve bootstrap" for the full table.
#
# Windows (PowerShell):
#   $env:RESOLVE_SCRIPT_API = "$env:PROGRAMDATA\Blackmagic Design\DaVinci Resolve\Support\Developer\Scripting"
#   $env:RESOLVE_SCRIPT_LIB = "C:\Program Files\Blackmagic Design\DaVinci Resolve\fusionscript.dll"
#   $env:PYTHONPATH         = "$env:PYTHONPATH;$env:RESOLVE_SCRIPT_API\Modules\"
#
# macOS:
#   export RESOLVE_SCRIPT_API="/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting"
#   export RESOLVE_SCRIPT_LIB="/Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Libraries/Fusion/fusionscript.so"
#   export PYTHONPATH="$PYTHONPATH:$RESOLVE_SCRIPT_API/Modules/"
#
# Linux:
#   export RESOLVE_SCRIPT_API="/opt/resolve/Developer/Scripting"
#   export RESOLVE_SCRIPT_LIB="/opt/resolve/libs/Fusion/fusionscript.so"
#   export PYTHONPATH="$PYTHONPATH:$RESOLVE_SCRIPT_API/Modules/"
#
# RESOLVE_SCRIPT_API=
# RESOLVE_SCRIPT_LIB=
# PYTHONPATH=
